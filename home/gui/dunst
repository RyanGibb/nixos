[global]
font="Noto Sans Mono 10"

origin=top-right
follow=keyboard

background="#434c5ee0"
frame_color="#434c5ee0"
foreground="#eceff4"

corner_radius=8
gap_size=8
vertical_alignement=top
offset=10x10

height=500

[urgency_low]
background="#2e3440e0"
frame_color="#2e3440e0"

[urgency_critical]
background="#bf616ae0"
frame_color="#bf616ae0"

# override_pause_level must exceed the level wm-presentation sets, so these
# two still show there. Everything else stays queued.
[status_bar]
appname="dunstify"
summary="Status"
override_pause_level=60

[battery_low]
appname="battery_monitor"
override_pause_level=60

